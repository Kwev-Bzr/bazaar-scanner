# Secrets et configuration locale ────────────────────────────────────────────
# config.ini contient le jeton personnel du streamer. Il est créé au premier
# lancement et ne doit JAMAIS être versionné.
config.ini
.dev.vars
.env

# Certificats de développement
**/certs/
*.pem
*.key

# Données du jeu ─────────────────────────────────────────────────────────────
