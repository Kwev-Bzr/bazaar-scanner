# pour compiler ou comprendre le projet.
GameData.db
*.db
extracted_cards_*.json
translations_*.csv
assets/
images/
characters/

# Sorties de compilation ─────────────────────────────────────────────────────
dist/
build/
node_modules/
*.exe
*.dll
*.blob

# Système
.DS_Store
Thumbs.db
